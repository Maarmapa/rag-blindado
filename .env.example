# Postgres con extensión pgvector. Supabase, Neon o Postgres local sirven.
DATABASE_URL=postgresql://usuario:password@host:5432/basedatos

# Clave de Anthropic para generación y para el modelo juez de las evals.
ANTHROPIC_API_KEY=

# Opcionales — valores por defecto en ragb/config.py
# Cambiar el modelo de embeddings obliga a RE-INDEXAR el corpus: el espacio
# vectorial es otro y los vectores ya guardados dejan de ser comparables.
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# GENERATION_MODEL=claude-opus-5
# JUDGE_MODEL=claude-haiku-4-5
# TOP_K=5
# MIN_FAITHFULNESS=0.85
